<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Scratch – Products</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; 
    }

    body { 
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      min-height: 100vh;
      color: #f1f5f9;
    }

    /* Enhanced Flash Messages */
    .flash-error {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(135deg, #ff4757, #ff3838);
      color: white;
      padding: 16px 28px;
      border-radius: 12px;
      font-weight: 600;
      z-index: 9999;
      box-shadow: 0 10px 30px rgba(255, 71, 87, 0.3);
      border: 2px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      animation: slideDown 0.5s ease forwards, glowPulse 2s infinite;
      max-width: 90%;
      text-align: center;
    }

    .flash-success {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(135deg, #00b894, #00a085);
      color: white;
      padding: 16px 28px;
      border-radius: 12px;
      font-weight: 600;
      z-index: 9999;
      box-shadow: 0 10px 30px rgba(0, 184, 148, 0.3);
      border: 2px solid rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(10px);
      animation: slideDown 0.5s ease forwards, glowPulse 2s infinite;
      max-width: 90%;
      text-align: center;
    }

    @keyframes slideDown {
      from { opacity: 0; transform: translate(-50%, -30px); }
      to { opacity: 1; transform: translate(-50%, 0); }
    }

    @keyframes glowPulse {
      0%, 100% { box-shadow: 0 10px 30px rgba(0, 184, 148, 0.3); }
      50% { box-shadow: 0 10px 40px rgba(0, 184, 148, 0.5); }
    }

    /* TOP NAVBAR - Enhanced with Bright Colors */
    .top-nav {
      height: 70px;
      padding: 0 40px;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 3px solid #00dbde;
      box-shadow: 0 5px 20px rgba(0, 219, 222, 0.2);
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
    }

    .nav-left {
      font-size: 28px;
      font-weight: 800;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 2px 10px rgba(0, 219, 222, 0.3);
      letter-spacing: 1px;
    }

    .nav-right {
      display: flex;
      gap: 32px;
      align-items: center;
    }

    .nav-right a {
      text-decoration: none;
      color: #e2e8f0;
      font-size: 16px;
      font-weight: 600;
      padding: 10px 18px;
      border-radius: 10px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      z-index: 1;
    }

    .nav-right a::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 100%;
      background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
      border-radius: 10px;
      transition: width 0.4s ease;
      z-index: -1;
    }

    .nav-right a:hover::before {
      width: 100%;
    }

    .nav-right a:hover {
      color: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 219, 222, 0.3);
    }

    .nav-right .logout {
      background: linear-gradient(135deg, #ff6b6b, #ee5a52);
      color: white;
      padding: 10px 22px;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(255, 107, 107, 0.3);
    }

    .nav-right .logout:hover {
      background: linear-gradient(135deg, #ff5252, #ff3838);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(255, 107, 107, 0.4);
    }

    /* Main Page Layout */
    .page {
      display: flex;
      padding: 40px;
      gap: 50px;
      animation: pageEnter 0.6s ease-out forwards;
      opacity: 0;
      transform: translateY(20px);
    }

    @keyframes pageEnter {
      to { opacity: 1; transform: translateY(0); }
    }

    /* LEFT SIDEBAR - Enhanced */
    .sidebar {
      width: 280px;
      background: rgba(30, 41, 59, 0.7);
      padding: 30px;
      border-radius: 20px;
      border: 2px solid rgba(0, 219, 222, 0.3);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
      position: sticky;
      top: 90px;
      height: fit-content;
    }

    .title {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 30px;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      padding-bottom: 10px;
      border-bottom: 2px solid rgba(0, 219, 222, 0.3);
    }

    .sort {
      margin-bottom: 35px;
    }

    .sort label {
      font-size: 16px;
      font-weight: 600;
      margin-right: 10px;
      color: #cbd5e1;
      display: block;
      margin-bottom: 10px;
    }

    select {
      width: 100%;
      padding: 12px 16px;
      font-size: 15px;
      background: rgba(15, 23, 42, 0.8);
      border: 2px solid #00dbde;
      border-radius: 10px;
      color: #f1f5f9;
      cursor: pointer;
      transition: all 0.3s ease;
      outline: none;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    select:hover {
      border-color: #fc00ff;
      box-shadow: 0 5px 20px rgba(252, 0, 255, 0.2);
    }

    select:focus {
      border-color: #00dbde;
      box-shadow: 0 0 0 3px rgba(0, 219, 222, 0.3);
    }

    .menu {
      margin-bottom: 40px;
    }

    .menu p {
      font-size: 16px;
      margin-bottom: 15px;
      cursor: pointer;
      padding: 12px 16px;
      border-radius: 10px;
      transition: all 0.3s ease;
      color: #cbd5e1;
      border-left: 3px solid transparent;
    }

    .menu p:hover {
      background: rgba(0, 219, 222, 0.1);
      color: #ffffff;
      border-left: 3px solid #00dbde;
      transform: translateX(5px);
    }

    .filter-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 15px;
      color: #ffffff;
      padding-bottom: 8px;
      border-bottom: 2px solid rgba(0, 219, 222, 0.3);
    }

    .filter p {
      font-size: 15px;
      margin-bottom: 12px;
      cursor: pointer;
      padding: 10px 14px;
      border-radius: 8px;
      transition: all 0.3s ease;
      color: #cbd5e1;
    }

    .filter p:hover {
      background: rgba(252, 0, 255, 0.1);
      color: #ffffff;
      transform: translateX(5px);
    }

    /* PRODUCT GRID - Enhanced */
    .content {
      flex: 1;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 30px;
      padding: 10px;
    }

    .card {
      background: rgba(30, 41, 59, 0.7);
      border-radius: 20px;
      overflow: hidden;
      border: 2px solid rgba(0, 219, 222, 0.2);
      transition: all 0.4s ease;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      backdrop-filter: blur(10px);
      opacity: 0;
      transform: translateY(20px) scale(0.95);
      animation: cardFade 0.5s ease-out forwards;
    }

    .card:hover {
      transform: translateY(-10px) scale(1.02);
      border-color: #00dbde;
      box-shadow: 0 20px 40px rgba(0, 219, 222, 0.3);
    }

    @keyframes cardFade {
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    /* Stagger animation for cards */
    .card:nth-child(1) { animation-delay: 0.05s; }
    .card:nth-child(2) { animation-delay: 0.1s; }
    .card:nth-child(3) { animation-delay: 0.15s; }
    .card:nth-child(4) { animation-delay: 0.2s; }
    .card:nth-child(5) { animation-delay: 0.25s; }
    .card:nth-child(6) { animation-delay: 0.3s; }
    .card:nth-child(7) { animation-delay: 0.35s; }
    .card:nth-child(8) { animation-delay: 0.4s; }

    .card-top {
      height: 220px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(0, 219, 222, 0.1), rgba(252, 0, 255, 0.1));
      position: relative;
    }

    .card-top::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, transparent 50%, rgba(0, 219, 222, 0.05) 100%);
    }

    .card-top img {
      max-width: 85%;
      max-height: 85%;
      width: auto;
      height: auto;
      display: block;
      object-fit: contain;
      transition: transform 0.5s ease;
      z-index: 1;
    }

    .card:hover .card-top img {
      transform: scale(1.1);
    }

    .card-bottom {
      min-height: 90px;
      padding: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(15, 23, 42, 0.9);
      border-top: 2px solid rgba(0, 219, 222, 0.2);
    }

    .info {
      color: #f1f5f9;
      flex: 1;
    }

    .info .name {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 8px;
      overflow: hidden;
      word-break: break-word;
      color: #ffffff;
    }

    .info .price {
      font-size: 18px;
      font-weight: 700;
      color: #00dbde;
      text-shadow: 0 2px 5px rgba(0, 219, 222, 0.3);
    }

    .add {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      color: white;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 5px 15px rgba(0, 219, 222, 0.3);
      border: 2px solid rgba(255, 255, 255, 0.2);
    }

    .add:hover {
      transform: scale(1.1) rotate(90deg);
      box-shadow: 0 8px 20px rgba(252, 0, 255, 0.4);
      background: linear-gradient(135deg, #fc00ff, #00dbde);
    }

    .add a {
      text-decoration: none;
      color: inherit;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Empty State */
    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 60px 20px;
      color: #cbd5e1;
      font-size: 18px;
    }

    /* Responsive Design */
    @media (max-width: 1200px) {
      .page {
        padding: 30px;
        gap: 30px;
      }
      
      .grid {
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 25px;
      }
    }

    @media (max-width: 992px) {
      .page {
        flex-direction: column;
      }
      
      .sidebar {
        width: 100%;
        position: static;
      }
      
      .grid {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      }
    }

    @media (max-width: 768px) {
      .top-nav {
        padding: 0 20px;
        height: 60px;
      }
      
      .nav-left {
        font-size: 24px;
      }
      
      .nav-right {
        gap: 15px;
      }
      
      .nav-right a {
        padding: 8px 12px;
        font-size: 14px;
      }
      
      .page {
        padding: 20px;
      }
      
      .grid {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 20px;
      }
    }

    @media (max-width: 576px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }
      
      .nav-right {
        gap: 10px;
      }
      
      .nav-right a {
        padding: 6px 10px;
        font-size: 13px;
      }
    }

    @media (max-width: 480px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    /* Scrollbar Styling */
    ::-webkit-scrollbar {
      width: 10px;
    }

    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.8);
    }

    ::-webkit-scrollbar-thumb {
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(135deg, #fc00ff, #00dbde);
    }

    /* Loading Animation for Cards */
    @keyframes shimmer {
      0% { background-position: -1000px 0; }
      100% { background-position: 1000px 0; }
    }

    .card.loading .card-top {
      background: linear-gradient(90deg, rgba(30, 41, 59, 0.2) 25%, rgba(0, 219, 222, 0.1) 50%, rgba(30, 41, 59, 0.2) 75%);
      background-size: 1000px 100%;
      animation: shimmer 2s infinite;
    }
  </style>
</head>
<body>

  <%if(error.length){%>
   <div class="flash-error">
    <%= error%>
  </div>
  <%}%>
  
  <%if(success.length){%>
    <div class="flash-success">
      <%= success%>
    </div>
  <%}%>

  <!-- TOP NAVBAR -->
  <nav class="top-nav">
    <div class="nav-left">Scratch</div>
    <div class="nav-right">
      <a href="/shop">Shop</a>
      <a href="/cart">Cart</a>
      <a href="/myaccount">My Account</a>
      <a href="/users/logout" class="logout">Logout</a>
    </div>
  </nav>

  <div class="page">
    <!-- SIDEBAR -->
    <div class="sidebar">
      <div class="title">Scratch</div>

      <div class="sort">
        <label>Sort by</label>
        <select id="priceFilter">
          <option value="">Price</option>
          <option value="500-1000">500 - 1000</option>
          <option value="1000-1500">1000 - 1500</option>
          <option value="1500-3000">1500 - 3000</option>
        </select>
      </div>

      <div class="menu">
        <p>New Collection</p>
        <p>All Products</p>
        <p>Discounted Products</p>
      </div>

      <div class="filter">
        <div class="filter-title">Filter by :</div>
        <p>Availability</p>
        <p>Discount</p>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="content">
      <div class="grid">
        <!-- PRODUCTS -->
        <%if(allProducts.length>0){%>
          <%allProducts.forEach(product=>{%>
            <div class="card">
              <a href="/yourproduct/<%=product._id%>"> <div class="card-top">
               <img src="data:image/jpeg;base64,<%=product.image.toString('base64')%>" alt="<%=product.name%>">
              </div></a>
              <div class="card-bottom">
                <div class="info">
                  <div class="name"><%=product.name%></div>
                  <div class="price">₹ <%=product.price%></div>
                </div>
                <div class="add">
                  <a href="/addtocart/<%=product._id%>?price=<%=price%>">+</a>
                </div>
              </div>
            </div>
          <%}) %>
        <%}else{%>
          <div class="empty-state">
            <h2>No products available</h2>
            <p>Check back soon for new arrivals!</p>
          </div>
        <%} %>
      </div>
    </div>
  </div>

  <script>
    // Price filter functionality
    document.getElementById("priceFilter").addEventListener("change", function () {
      const value = this.value;
      if (!value) return;
      window.location.href = `/shop?price=${value}`;
    });

    // Auto-hide flash messages
    setTimeout(() => {
      const flashError = document.querySelector('.flash-error');
      const flashSuccess = document.querySelector('.flash-success');
      
      if (flashError) {
        flashError.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        flashError.style.opacity = '0';
        flashError.style.transform = 'translate(-50%, -30px)';
        setTimeout(() => flashError.remove(), 500);
      }
      
      if (flashSuccess) {
        flashSuccess.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        flashSuccess.style.opacity = '0';
        flashSuccess.style.transform = 'translate(-50%, -30px)';
        setTimeout(() => flashSuccess.remove(), 500);
      }
    }, 5000);

    // Interactive menu items
    document.querySelectorAll('.menu p, .filter p').forEach(item => {
      item.addEventListener('click', function() {
        // Remove active class from all
        document.querySelectorAll('.menu p, .filter p').forEach(p => {
          p.style.background = '';
          p.style.color = '';
        });
        
        // Add active style to clicked
        this.style.background = 'linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2))';
        this.style.color = '#ffffff';
        this.style.borderLeft = '3px solid #00dbde';
        
        // Add your filter logic here
        console.log('Filter by:', this.textContent);
      });
    });

    // Card hover effect enhancement
    document.querySelectorAll('.card').forEach(card => {
      card.addEventListener('mouseenter', function() {
        const addBtn = this.querySelector('.add');
        if (addBtn) {
          addBtn.style.transform = 'scale(1.1)';
        }
      });
      
      card.addEventListener('mouseleave', function() {
        const addBtn = this.querySelector('.add');
        if (addBtn) {
          addBtn.style.transform = 'scale(1)';
        }
      });
    });
  </script>
</body>
</html>