
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account | CyberProfile</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            color: #f1f5f9;
        }

        /* TOP NAVBAR - Cyber Style */
        .top-nav {
            height: 70px;
            padding: 0 40px;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 3px solid #00dbde;
            box-shadow: 0 5px 20px rgba(0, 219, 222, 0.2);
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(10px);
        }

        .nav-left {
            font-size: 28px;
            font-weight: 800;
            background: linear-gradient(135deg, #00dbde, #fc00ff);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 2px 10px rgba(0, 219, 222, 0.3);
            letter-spacing: 1px;
        }

        .nav-right {
            display: flex;
            gap: 32px;
            align-items: center;
        }

        .nav-right a {
            text-decoration: none;
            color: #e2e8f0;
            font-size: 16px;
            font-weight: 600;
            padding: 10px 18px;
            border-radius: 10px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

        .nav-right a::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 100%;
            background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
            border-radius: 10px;
            transition: width 0.4s ease;
            z-index: -1;
        }

        .nav-right a:hover::before {
            width: 100%;
        }

        .nav-right a:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 219, 222, 0.3);
        }

        .nav-right .active {
            background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
            color: #ffffff;
            border: 1px solid rgba(0, 219, 222, 0.5);
        }

        .nav-right .logout {
            background: linear-gradient(135deg, #ff4757, #ff3838);
            color: white;
            padding: 10px 22px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(255, 71, 87, 0.3);
        }

        .nav-right .logout:hover {
            background: linear-gradient(135deg, #ff5252, #ff3838);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 107, 107, 0.4);
        }

        /* Main Container */
        .account-container {
            max-width: 1300px;
            margin: 40px auto;
            padding: 0 30px;
            animation: pageEnter 0.6s ease-out forwards;
            opacity: 0;
            transform: translateY(20px);
        }

        @keyframes pageEnter {
            to { opacity: 1; transform: translateY(0); }
        }

        
        .cyber-header {
            background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(22, 33, 62, 0.9));
            border-radius: 25px;
            padding: 50px;
            margin-bottom: 40px;
            border: 2px solid #00dbde;
            box-shadow: 0 10px 30px rgba(0, 219, 222, 0.2);
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(10px);
        }

        .cyber-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #00dbde, #fc00ff, #00dbde);
            animation: scanline 3s linear infinite;
        }

        @keyframes scanline {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .cyber-header h1 {
            font-size: 3.2rem;
            font-weight: 800;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #00dbde, #fc00ff);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 4px 15px rgba(0, 219, 222, 0.3);
        }

        .cyber-header p {
            font-size: 1.3rem;
            color: #cbd5e1;
            max-width: 600px;
        }

        /* Profile Content Grid */
        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
            margin-bottom: 40px;
        }

        @media (max-width: 1024px) {
            .profile-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Profile Card - Cyber Style */
        .profile-card {
            background: rgba(30, 41, 59, 0.7);
            border-radius: 20px;
            padding: 35px;
            border: 2px solid rgba(0, 219, 222, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            transition: all 0.4s ease;
            opacity: 0;
            transform: translateY(20px) scale(0.95);
            animation: cardFade 0.5s ease-out forwards 0.1s;
        }

        .profile-card:hover {
            border-color: #00dbde;
            box-shadow: 0 15px 40px rgba(0, 219, 222, 0.3);
            transform: translateY(-5px) scale(1.01);
        }

        @keyframes cardFade {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .avatar-container {
            position: relative;
            width: 180px;
            height: 180px;
            margin: 0 auto 30px;
        }

       .avatar-ring {
    position: absolute;
    top: -10px;
    left: -10px;
    right: -10px;
    bottom: -10px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #00dbde, #fc00ff, #00dbde);
    animation: rotate 20s linear infinite;
}

.avatar-ring::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    right: 3px;
    bottom: 3px;
    background: #1e293b; /* Match your background color */
    border-radius: 50%;
    z-index: 1;
}

        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(0, 219, 222, 0.3), rgba(252, 0, 255, 0.3));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4.5rem;
            color: #00dbde;
            border: 5px solid rgba(15, 23, 42, 0.9);
            z-index: 2;
            position: relative;
        }

        .user-name {
            font-size: 2rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 10px;
            color: #ffffff;
            text-shadow: 0 2px 10px rgba(0, 219, 222, 0.3);
        }

        .user-email {
            text-align: center;
            color: #94a3b8;
            font-size: 1.1rem;
            margin-bottom: 25px;
        }

        .member-badge {
            display: inline-block;
            padding: 10px 25px;
            border-radius: 25px;
            background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
            border: 1px solid rgba(0, 219, 222, 0.5);
            color: #00dbde;
            font-weight: 600;
            margin: 0 auto 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: fit-content;
        }

        .member-since {
            background: rgba(15, 23, 42, 0.9);
            padding: 20px;
            border-radius: 15px;
            border-left: 4px solid #fc00ff;
            margin-top: 25px;
            text-align: center;
        }

        /* Details Card */
        .details-card {
            background: rgba(30, 41, 59, 0.7);
            border-radius: 20px;
            padding: 40px;
            border: 2px solid rgba(0, 219, 222, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            transition: all 0.4s ease;
            opacity: 0;
            transform: translateY(20px) scale(0.95);
            animation: cardFade 0.5s ease-out forwards 0.2s;
        }

        .details-card:hover {
            border-color: #00dbde;
            box-shadow: 0 15px 40px rgba(0, 219, 222, 0.3);
        }

        .section-title {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 30px;
            color: #00dbde;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(0, 219, 222, 0.3);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title i {
            color: #fc00ff;
        }

        /* Info Grid */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 35px;
        }

        .info-item {
            background: rgba(15, 23, 42, 0.9);
            padding: 22px;
            border-radius: 15px;
            border: 1px solid rgba(0, 219, 222, 0.2);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .info-item:hover {
            border-color: #00dbde;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 219, 222, 0.2);
        }

        .info-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #00dbde, #fc00ff);
        }

        .info-label {
            font-size: 0.95rem;
            color: #94a3b8;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .info-label i {
            color: #fc00ff;
            width: 20px;
        }

        .info-value {
            font-size: 1.3rem;
            font-weight: 600;
            color: #ffffff;
            word-break: break-word;
        }

        /* Stats Section */
        .stats-section {
            background: linear-gradient(135deg, rgba(26, 26, 46, 0.9), rgba(22, 33, 62, 0.9));
            border-radius: 20px;
            padding: 40px;
            margin-bottom: 40px;
            border: 2px solid #fc00ff;
            box-shadow: 0 10px 30px rgba(252, 0, 255, 0.2);
            opacity: 0;
            transform: translateY(20px);
            animation: cardFade 0.5s ease-out forwards 0.3s;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
            margin-top: 30px;
        }

        .stat-item {
            background: rgba(15, 23, 42, 0.9);
            padding: 25px;
            border-radius: 15px;
            border: 1px solid rgba(0, 219, 222, 0.2);
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-item:hover {
            border-color: #fc00ff;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(252, 0, 255, 0.2);
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #00dbde, #fc00ff);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .stat-label {
            font-size: 1rem;
            color: #cbd5e1;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Cyber Buttons */
        .action-buttons {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 35px;
        }

        .cyber-btn {
            padding: 16px 32px;
            border-radius: 12px;
            border: 2px solid transparent;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            position: relative;
            overflow: hidden;
            min-width: 180px;
        }

        .cyber-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .cyber-btn:hover::before {
            opacity: 1;
        }

        .cyber-btn-primary {
            background: linear-gradient(135deg, #00dbde, #0099ff);
            color: white;
            box-shadow: 0 5px 20px rgba(0, 219, 222, 0.3);
        }

        .cyber-btn-secondary {
            background: linear-gradient(135deg, #fc00ff, #ff0099);
            color: white;
            box-shadow: 0 5px 20px rgba(252, 0, 255, 0.3);
        }

        .cyber-btn-outline {
            background: transparent;
            color: #00dbde;
            border: 2px solid #00dbde;
        }

        .cyber-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        .cyber-btn-primary:hover {
            box-shadow: 0 10px 30px rgba(0, 219, 222, 0.4);
        }

        .cyber-btn-secondary:hover {
            box-shadow: 0 10px 30px rgba(252, 0, 255, 0.4);
        }

        /* Activity Feed */
        .activity-section {
            background: rgba(30, 41, 59, 0.7);
            border-radius: 20px;
            padding: 40px;
            border: 2px solid rgba(0, 219, 222, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            opacity: 0;
            transform: translateY(20px);
            animation: cardFade 0.5s ease-out forwards 0.4s;
        }

        .activity-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 25px;
        }

        .activity-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px;
            background: rgba(15, 23, 42, 0.9);
            border-radius: 15px;
            border: 1px solid rgba(0, 219, 222, 0.2);
            transition: all 0.3s ease;
        }

        .activity-item:hover {
            border-color: #00dbde;
            transform: translateX(5px);
            box-shadow: 0 5px 20px rgba(0, 219, 222, 0.2);
        }

        .activity-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #00dbde;
            font-size: 1.3rem;
            border: 1px solid rgba(0, 219, 222, 0.3);
        }

        .activity-content {
            flex: 1;
        }

        .activity-title {
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 5px;
        }

        .activity-time {
            font-size: 0.9rem;
            color: #94a3b8;
        }

        /* Security Badge */
        .security-badge {
            background: rgba(0, 184, 148, 0.1);
            border: 1px solid rgba(0, 184, 148, 0.3);
            border-radius: 15px;
            padding: 20px;
            margin-top: 30px;
            display: flex;
            align-items: center;
            gap: 15px;
            color: #00b894;
        }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.8);
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #00dbde, #fc00ff);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(135deg, #fc00ff, #00dbde);
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .top-nav {
                padding: 0 20px;
                height: 60px;
            }
            
            .nav-left {
                font-size: 24px;
            }
            
            .nav-right {
                gap: 15px;
            }
            
            .nav-right a {
                padding: 8px 12px;
                font-size: 14px;
            }
            
            .account-container {
                padding: 0 20px;
                margin: 20px auto;
            }
            
            .cyber-header {
                padding: 30px;
            }
            
            .cyber-header h1 {
                font-size: 2.2rem;
            }
            
            .profile-grid {
                gap: 20px;
            }
            
            .profile-card, .details-card, .stats-section, .activity-section {
                padding: 25px;
            }
            
            .avatar-container {
                width: 140px;
                height: 140px;
            }
            
            .info-grid {
                grid-template-columns: 1fr;
            }
            
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .action-buttons {
                justify-content: center;
            }
            
            .cyber-btn {
                min-width: 160px;
                padding: 14px 25px;
            }
        }

        @media (max-width: 480px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
            
            .cyber-btn {
                min-width: 100%;
            }
            
            .nav-right a:not(.logout) {
                display: none;
            }
        }

        /* Flash Messages */
        .flash-success {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #00b894, #00a085);
            color: white;
            padding: 16px 28px;
            border-radius: 12px;
            font-weight: 600;
            z-index: 9999;
            box-shadow: 0 10px 30px rgba(0, 184, 148, 0.3);
            border: 2px solid rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            animation: slideDown 0.5s ease forwards, glowPulse 2s infinite;
            max-width: 90%;
            text-align: center;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translate(-50%, -30px); }
            to { opacity: 1; transform: translate(-50%, 0); }
        }
    </style>
</head>
<body>
    <!-- Top Navigation -->
    <nav class="top-nav">
        <div class="nav-left">
             Scratch
        </div>
        <div class="nav-right">
           
            <a href="/shop"><i class="fas fa-store"></i> Shop</a>
            <a href="/cart"><i class="fas fa-shopping-cart"></i> Cart</a>
           
            
            <a href="/users/logout" class="logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="account-container">
     
        <header class="cyber-header">
            <h1>Your PROFILE</h1>
           
        </header>

        <!-- Profile Grid -->
        <div class="profile-grid">
            <!-- Profile Card -->
            <div class="profile-card">
                <div class="avatar-container">
                    <div class="avatar-ring"></div>
                    <div class="avatar">
                        
                    </div>
                </div>
                
                <h2 class="user-name" id="userName"><%=user.fullname%></h2>
                <p class="user-email" id="userEmail"><%=user.email%></p>
                
                <div class="member-badge">
                    <i class="fas fa-shield-alt"></i> PREMIUM MEMBER
                </div>
                
                <div class="member-since">
                    <p><i class="fas fa-calendar-alt"></i> Joined: <span id="joinDate">JAN 2023</span></p>
                    <p style="margin-top: 10px; color: #00dbde; font-size: 0.9rem;">
                        <i class="fas fa-bolt"></i> Active for 420 days
                    </p>
                </div>
            </div>

            <!-- Details Card -->
            <div class="details-card">
                <h3 class="section-title">
                    <i class="fas fa-id-card"></i> IDENTITY DATA
                </h3>
                
                <div class="info-grid">
                   
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-phone-alt"></i> COMMUNICATION</div>
                        <div class="info-value" id="userPhone">+1 (555) 987-6543</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-map-marker-alt"></i> LOCATION</div>
                        <div class="info-value" id="userLocation">NEON CITY, CYBER DISTRICT</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-user-tag"></i> ACCOUNT TIER</div>
                        <div class="info-value" id="accountType">OMEGA TIER</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-envelope"></i> EMAIL STATUS</div>
                        <div class="info-value" style="color: #00b894;">VERIFIED ✓</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label"><i class="fas fa-bell"></i> NOTIFICATIONS</div>
                        <div class="info-value">ACTIVE</div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <button class="cyber-btn cyber-btn-primary" onclick="editProfile()">
                        <i class="fas fa-edit"></i> EDIT PROFILE
                    </button>
                    <button class="cyber-btn cyber-btn-secondary" onclick="changePassword()">
                        <i class="fas fa-key"></i> SECURITY
                    </button>
                   
                </div>
            </div>
        </div>

    

      
    </div>

    <script>
        // Initialize with your backend data - Replace these with your actual variables
        document.addEventListener('DOMContentLoaded', function() {
            // These should be your actual backend variables
            const userData = {
                name:` <%=user.fullname%>`, // Replace with your variable
                email: "<%=user.email%>", // Replace with your variable
                userId: "CYB-001-789456", // Replace with your variable
                phone: "+1 (555) 987-6543", // Replace with your variable
                location: "NEON CITY, CYBER DISTRICT", // Replace with your variable
                accountType: "OMEGA TIER", // Replace with your variable
                joinDate: "JAN 2023", // Replace with your variable
                status: "active", // Replace with your variable
                totalOrders: 47, // Replace with your variable
                totalSpent: 8942, // Replace with your variable
                wishlistItems: 18 // Replace with your variable
            };

            // Populate the page with data
            document.getElementById('userName').textContent = userData.name;
            document.getElementById('userEmail').textContent = userData.email;
            document.getElementById('userId').textContent = userData.userId;
            document.getElementById('userPhone').textContent = userData.phone;
            document.getElementById('userLocation').textContent = userData.location;
            document.getElementById('accountType').textContent = userData.accountType;
            document.getElementById('joinDate').textContent = userData.joinDate;
            document.getElementById('totalOrders').textContent = userData.totalOrders;
            document.getElementById('totalSpent').textContent = `$${userData.totalSpent}`;
            document.getElementById('wishlistItems').textContent = userData.wishlistItems;
            
            // Calculate account age in days (you should calculate this from joinDate)
            const accountAge = 420; // Replace with actual calculation
            document.getElementById('accountAge').textContent = accountAge;
        });

        // Button functions - Connect these to your backend
