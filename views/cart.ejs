<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Scratch - Your Cart</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* Reset and Base Styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      min-height: 100vh;
      color: #f1f5f9;
    }

    /* Navigation Bar */
    .navbar {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      padding: 0 40px;
      height: 70px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 3px solid #00dbde;
      box-shadow: 0 5px 20px rgba(0, 219, 222, 0.2);
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
    }

    .logo {
      font-size: 28px;
      font-weight: 800;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 2px 10px rgba(0, 219, 222, 0.3);
      letter-spacing: 1px;
    }

    .nav-links {
      display: flex;
      gap: 32px;
      align-items: center;
    }

    .nav-links a {
      text-decoration: none;
      color: #e2e8f0;
      font-size: 16px;
      font-weight: 600;
      padding: 10px 18px;
      border-radius: 10px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      z-index: 1;
    }

    .nav-links a::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 100%;
      background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
      border-radius: 10px;
      transition: width 0.4s ease;
      z-index: -1;
    }

    .nav-links a:hover::before {
      width: 100%;
    }

    .nav-links a:hover {
      color: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 219, 222, 0.3);
    }

    .nav-links .active {
      background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
      color: #ffffff;
      border: 1px solid rgba(0, 219, 222, 0.3);
    }

    /* Main Container */
    .main-container {
      max-width: 1400px;
      margin: 40px auto;
      padding: 0 40px;
      display: flex;
      gap: 40px;
      animation: fadeIn 0.8s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Cart Items Section */
    .cart-items {
      flex: 2;
      background: rgba(30, 41, 59, 0.7);
      border-radius: 20px;
      padding: 30px;
      border: 2px solid rgba(0, 219, 222, 0.3);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
    }

    .cart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 2px solid rgba(0, 219, 222, 0.2);
    }

    .cart-title {
      font-size: 28px;
      font-weight: 700;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }

    .item-count {
      font-size: 18px;
      color: #cbd5e1;
      background: rgba(0, 219, 222, 0.1);
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid rgba(0, 219, 222, 0.3);
    }

    /* Cart Item Card */
    .cart-item {
      display: flex;
      gap: 25px;
      padding: 25px;
      margin-bottom: 25px;
      background: rgba(15, 23, 42, 0.9);
      border-radius: 15px;
      border: 2px solid rgba(0, 219, 222, 0.2);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .cart-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 5px;
      height: 100%;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
    }

    .cart-item:hover {
      transform: translateY(-5px);
      border-color: #00dbde;
      box-shadow: 0 10px 25px rgba(0, 219, 222, 0.2);
    }

    .item-image {
      width: 160px;
      height: 160px;
      border-radius: 12px;
      overflow: hidden;
      border: 3px solid rgba(0, 219, 222, 0.3);
      background: linear-gradient(135deg, rgba(0, 219, 222, 0.1), rgba(252, 0, 255, 0.1));
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .item-image img {
      max-width: 90%;
      max-height: 90%;
      object-fit: contain;
      transition: transform 0.5s ease;
    }

    .cart-item:hover .item-image img {
      transform: scale(1.05);
    }

    .item-details {
      flex: 1;
      padding: 10px 0;
    }

    .item-name {
      font-size: 20px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .item-tag {
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      color: white;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .item-specs {
      color: #cbd5e1;
      margin-bottom: 15px;
      font-size: 14px;
      display: flex;
      gap: 20px;
    }

    .item-price {
      font-size: 22px;
      font-weight: 800;
      color: #00dbde;
      text-shadow: 0 2px 5px rgba(0, 219, 222, 0.3);
    }

    .item-controls {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
      min-width: 120px;
    }

    .quantity-control {
      display: flex;
      align-items: center;
      gap: 5px;
      background: rgba(30, 41, 59, 0.8);
      border-radius: 10px;
      padding: 5px;
      border: 2px solid rgba(0, 219, 222, 0.3);
    }

    .qty-btn {
      width: 36px;
      height: 36px;
      border: none;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      color: white;
      font-size: 18px;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }

    .qty-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 5px 15px rgba(0, 219, 222, 0.3);
    }

    .qty-value {
      width: 50px;
      text-align: center;
      font-size: 18px;
      font-weight: 600;
      color: #ffffff;
    }

    .remove-btn {
      color: #ff6b6b;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      padding: 8px 16px;
      border-radius: 8px;
      background: rgba(255, 107, 107, 0.1);
      border: 1px solid rgba(255, 107, 107, 0.3);
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .remove-btn:hover {
      background: rgba(255, 107, 107, 0.2);
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(255, 107, 107, 0.2);
    }

    /* Empty Cart State */
    .empty-cart {
      text-align: center;
      padding: 60px 20px;
      color: #cbd5e1;
    }

    .empty-icon {
      font-size: 80px;
      color: #00dbde;
      margin-bottom: 20px;
      opacity: 0.7;
    }

    .empty-cart h3 {
      font-size: 24px;
      margin-bottom: 10px;
      color: #ffffff;
    }

    .shop-btn {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 30px;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: 600;
      transition: all 0.3s ease;
      border: 2px solid rgba(255, 255, 255, 0.2);
    }

    .shop-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(0, 219, 222, 0.3);
    }

    /* Order Summary */
    .order-summary {
      width: 380px;
      background: rgba(30, 41, 59, 0.7);
      border-radius: 20px;
      padding: 30px;
      border: 2px solid rgba(0, 219, 222, 0.3);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
      position: sticky;
      top: 100px;
      height: fit-content;
    }

    .summary-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 25px;
      padding-bottom: 15px;
      border-bottom: 2px solid rgba(0, 219, 222, 0.3);
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .summary-label {
      color: #cbd5e1;
      font-size: 16px;
    }

    .summary-value {
      color: #ffffff;
      font-weight: 600;
      font-size: 16px;
    }

    .delivery-value {
      color: #00dbde;
    }

    .total-row {
      display: flex;
      justify-content: space-between;
      margin: 25px 0;
      padding: 20px 0;
      border-top: 2px solid rgba(0, 219, 222, 0.3);
      border-bottom: 2px solid rgba(0, 219, 222, 0.3);
      font-size: 20px;
    }

    .total-label {
      color: #ffffff;
      font-weight: 700;
    }

    .total-value {
      font-size: 28px;
      font-weight: 800;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 2px 5px rgba(0, 219, 222, 0.3);
    }

    .checkout-btn {
      width: 100%;
      padding: 18px;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      border: none;
      border-radius: 12px;
      color: white;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 10px 25px rgba(0, 219, 222, 0.3);
      margin-top: 20px;
    }

    .checkout-btn:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0, 219, 222, 0.4);
    }

    .checkout-btn:active {
      transform: translateY(-2px);
    }

    .payment-icons {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-top: 20px;
      font-size: 24px;
      color: #cbd5e1;
    }

    /* Footer */
    .footer {
      text-align: center;
      padding: 30px;
      color: #94a3b8;
      font-size: 14px;
      border-top: 1px solid rgba(0, 219, 222, 0.2);
      margin-top: 50px;
      background: rgba(15, 23, 42, 0.8);
    }

    .footer-logo {
      font-size: 20px;
      font-weight: 700;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      margin-bottom: 10px;
    }

    /* Responsive Design */
    @media (max-width: 1200px) {
      .main-container {
        padding: 0 30px;
        gap: 30px;
      }
      
      .order-summary {
        width: 340px;
      }
    }

    @media (max-width: 992px) {
      .main-container {
        flex-direction: column;
      }
      
      .order-summary {
        width: 100%;
        position: static;
      }
      
      .item-image {
        width: 140px;
        height: 140px;
      }
    }

    @media (max-width: 768px) {
      .navbar {
        padding: 0 20px;
        height: 60px;
      }
      
      .logo {
        font-size: 24px;
      }
      
      .nav-links {
        gap: 15px;
      }
      
      .nav-links a {
        padding: 8px 12px;
        font-size: 14px;
      }
      
      .main-container {
        padding: 0 20px;
      }
      
      .cart-item {
        flex-direction: column;
        gap: 20px;
      }
      
      .item-image {
        width: 100%;
        height: 200px;
      }
      
      .item-controls {
        flex-direction: row;
        justify-content: space-between;
        width: 100%;
      }
    }

    @media (max-width: 480px) {
      .navbar {
        flex-direction: column;
        height: auto;
        padding: 15px;
      }
      
      .nav-links {
        margin-top: 15px;
        flex-wrap: wrap;
        justify-content: center;
      }
      
      .cart-items,
      .order-summary {
        padding: 20px;
      }
      
      .cart-title {
        font-size: 24px;
      }
      
      .item-name {
        font-size: 18px;
      }
      
      .item-specs {
        flex-direction: column;
        gap: 5px;
      }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 10px;
    }

    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.8);
    }

    ::-webkit-scrollbar-thumb {
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(135deg, #fc00ff, #00dbde);
    }
  </style>
</head>

<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="logo">Scratch</div>
    <div class="nav-links">
      <a href="/shop">Shop</a>
      <a href="#" class="active">Cart</a>
      <a href="/myaccount">My Account</a>
    </div>
  </nav>

  <!-- Main Container -->
  <div class="main-container">
    
    <!-- Cart Items Section -->
    <div class="cart-items">
      <div class="cart-header">
        <h1 class="cart-title">Your Shopping Cart</h1>
        <div class="item-count"><%=user.cart.length%> items</div>
      </div>

      <!-- Cart Items List -->
      <div class="cart-items-list">
        <% if(user.cart.length > 0) { %>
          <% user.cart.forEach((product, index) => { %>
            <div class="cart-item">
              <div class="item-image">
                <img src="data:image/jpeg;base64,<%=product.image.toString('base64')%>" alt="<%=product.name%>">
              </div>
              
              <div class="item-details">
                <div class="item-name">
                  <%=product.name%>
                  <span class="item-tag">Bestseller</span>
                </div>
                <div class="item-specs">
                  <span>Size: M</span>
                  <span>Color: Black</span>
                  <span>In Stock</span>
                </div>
                <div class="item-price">₹<%=product.price%></div>
              </div>
              
              <div class="item-controls">
                <div class="quantity-control">
                  <button class="qty-btn minus-btn">−</button>
                  <span class="qty-value">1</span>
                  <button class="qty-btn plus-btn">+</button>
                </div>
                <a class="remove-btn" href="/remove/<%=product._id%>">
                  <i class="fas fa-trash-alt"></i> Remove
                </a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-cart">
            <div class="empty-icon">
              <i class="fas fa-shopping-cart"></i>
            </div>
            <h3>Your cart is empty</h3>
            <p>Add some amazing products to get started!</p>
            <a href="/shop" class="shop-btn">Continue Shopping</a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Order Summary -->
    <div class="order-summary">
      <h2 class="summary-title">Order Summary</h2>
      
      <!-- Calculate total price without variable declaration conflict -->
      <%
        let calculatedTotal = 0;
        user.cart.forEach(product => {
          calculatedTotal += product.price;
        })
        const taxAmount = Math.round(calculatedTotal * 0.18);
        const finalTotal = calculatedTotal + 99 + taxAmount;
      %>
      
      <div class="summary-row">
        <span class="summary-label">Subtotal (<%=user.cart.length%> items)</span>
        <span class="summary-value">₹<%=calculatedTotal%></span>
      </div>
      
      <div class="summary-row">
        <span class="summary-label">Delivery Charges</span>
        <span class="summary-value delivery-value">₹99</span>
      </div>
      
      <div class="summary-row">
        <span class="summary-label">Taxes & Fees</span>
        <span class="summary-value">₹<%=taxAmount%></span>
      </div>
      
      <div class="total-row">
        <span class="total-label">Total Amount</span>
        <span class="total-value">₹<%=finalTotal%></span>
      </div>
      
      <button class="checkout-btn" id="checkoutButton">
        <i class="fas fa-lock"></i> Proceed to Checkout
      </button>
      
      <div class="payment-icons">
        <i class="fab fa-cc-visa"></i>
        <i class="fab fa-cc-mastercard"></i>
        <i class="fab fa-cc-paypal"></i>
        <i class="fab fa-cc-apple-pay"></i>
      </div>
      
      <div style="margin-top: 20px; font-size: 14px; color: #94a3b8; text-align: center;">
        <i class="fas fa-shield-alt"></i> Secure checkout • 256-bit encryption
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="footer">
    <div class="footer-logo">Scratch</div>
    <p>Premium E-Commerce Experience</p>
    <p style="margin-top: 10px;">© 2026 Scratch. All rights reserved.</p>
  </div>

  <script>
    // Set staggered animations for cart items
    document.addEventListener('DOMContentLoaded', function() {
      const cartItems = document.querySelectorAll('.cart-item');
      cartItems.forEach((item, index) => {
        // Apply staggered animation delay
        item.style.animation = 'slideIn 0.5s ease ' + (index * 0.1) + 's forwards';
        item.style.opacity = '0';
      });
    });

    // Slide in animation
    const style = document.createElement('style');
    style.textContent = `
      @keyframes slideIn {
        from { opacity: 0; transform: translateX(-20px); }
        to { opacity: 1; transform: translateX(0); }
      }
    `;
    document.head.appendChild(style);

    // Quantity control functionality
    document.querySelectorAll('.qty-btn').forEach(button => {
      button.addEventListener('click', function() {
        const quantitySpan = this.parentElement.querySelector('.qty-value');
        let quantity = parseInt(quantitySpan.textContent);
        
        if (this.classList.contains('plus-btn')) {
          quantity++;
        } else if (this.classList.contains('minus-btn') && quantity > 1) {
          quantity--;
        }
        
        quantitySpan.textContent = quantity;
        
        // Animation
        quantitySpan.style.transform = 'scale(1.2)';
        setTimeout(() => {
          quantitySpan.style.transform = 'scale(1)';
        }, 200);
      });
    });

    // Remove button confirmation
    document.querySelectorAll('.remove-btn').forEach(button => {
      button.addEventListener('click', function(e) {
        if (!confirm('Are you sure you want to remove this item from your cart?')) {
          e.preventDefault();
        }
      });
    });

    // Checkout button functionality
    const checkoutBtn = document.getElementById('checkoutButton');
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', function() {
        // Get cart length from the DOM
        const cartCountElement = document.querySelector('.item-count');
        const cartCountText = cartCountElement ? cartCountElement.textContent : '0 items';
        const cartItemCount = parseInt(cartCountText);
        
        if (cartItemCount === 0) {
          alert('Your cart is empty! Add some products before checkout.');
          return;
        }
        
        // Animation and processing
        this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        this.disabled = true;
        
        // Simulate checkout process
        setTimeout(() => {
          alert('Checkout functionality would be implemented here!');
          this.innerHTML = '<i class="fas fa-lock"></i> Proceed to Checkout';
          this.disabled = false;
        }, 1500);
      });
    }

    // Cart item hover animations
    document.querySelectorAll('.cart-item').forEach(item => {
      item.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-5px)';
      });
      
      item.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0)';
      });
    });

    // Update cart count animation
    const itemCount = document.querySelector('.item-count');
    if (itemCount) {
      itemCount.style.transition = 'all 0.3s ease';
      itemCount.addEventListener('mouseenter', function() {
        this.style.transform = 'scale(1.1)';
        this.style.boxShadow = '0 5px 15px rgba(0, 219, 222, 0.3)';
      });
      
      itemCount.addEventListener('mouseleave', function() {
        this.style.transform = 'scale(1)';
        this.style.boxShadow = 'none';
      });
    }

    // Image loading animation
    document.querySelectorAll('.item-image img').forEach(img => {
      img.addEventListener('load', function() {
        this.style.opacity = '1';
        this.style.transition = 'opacity 0.5s ease';
      });
      
      // Set initial opacity
      img.style.opacity = '0.7';
    });
  </script>
</body>
</html>