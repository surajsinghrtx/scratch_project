<script>
  let selectedRating = 0;

  function openReviewForm() {
    document.getElementById("reviewForm").classList.add("active");
  }

  function closeReviewForm() {
    document.getElementById("reviewForm").classList.remove("active");
  }

  

  

  // SUBMIT REVIEW → BACKEND
  async function submitReview() {
  
    const comment = document.getElementById("reviewText").value.trim();

    if (comment==="") {
      alert("Please give review");
      return;
    }

    // DATA THAT GOES TO BACKEND
    const reviewPayload = {
      
      comment: comment           // fetch in backened by req.body.comment
    };

    try {
      // 👇 DUMMY ROUTE — CHANGE THIS LATER

      const res = await fetch("/api/reviews/<%=product._id%>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(reviewPayload)
      });

      if (!res.ok) throw new Error("Failed");

     
      

      resetForm();
      closeReviewForm();

    } catch (err) {
      alert("Server error");
      console.error(err);
    }
  }

 function resetForm() {
  document.getElementById("reviewText").value = "";
 
}




</script>

  

</body>
