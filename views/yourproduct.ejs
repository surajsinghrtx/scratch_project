<!-- <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Scratch - Product Details</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css">
  <style>
    /* Reset and Base Styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      min-height: 100vh;
      color: #f1f5f9;
    }

    /* Navigation Bar */
    .navbar {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      padding: 0 40px;
      height: 70px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 3px solid #00dbde;
      box-shadow: 0 5px 20px rgba(0, 219, 222, 0.2);
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
    }

    .logo {
      font-size: 28px;
      font-weight: 800;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 2px 10px rgba(0, 219, 222, 0.3);
      letter-spacing: 1px;
    }

    .nav-links {
      display: flex;
      gap: 32px;
      align-items: center;
    }

    .nav-links a {
      text-decoration: none;
      color: #e2e8f0;
      font-size: 16px;
      font-weight: 600;
      padding: 10px 18px;
      border-radius: 10px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      z-index: 1;
    }

    .nav-links a::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 100%;
      background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
      border-radius: 10px;
      transition: width 0.4s ease;
      z-index: -1;
    }

    .nav-links a:hover::before {
      width: 100%;
    }

    .nav-links a:hover {
      color: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 219, 222, 0.3);
    }

    /* Main Container */
    .product-container {
      max-width: 1400px;
      margin: 40px auto;
      padding: 0 40px;
      animation: fadeIn 0.8s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Product Grid */
    .product-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      margin-bottom: 60px;
    }

    /* Image Gallery */
    .image-gallery {
      background: rgba(30, 41, 59, 0.7);
      border-radius: 20px;
      padding: 30px;
      border: 2px solid rgba(0, 219, 222, 0.3);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
    }

    .main-image-container {
      width: 100%;
      height: 500px;
      border-radius: 15px;
      overflow: hidden;
      margin-bottom: 20px;
      border: 3px solid rgba(0, 219, 222, 0.4);
      background: linear-gradient(135deg, rgba(0, 219, 222, 0.1), rgba(252, 0, 255, 0.1));
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .main-image {
      max-width: 90%;
      max-height: 90%;
      object-fit: contain;
      transition: transform 0.5s ease;
    }

    .zoom-icon {
      position: absolute;
      top: 20px;
      right: 20px;
      background: rgba(0, 0, 0, 0.7);
      color: white;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
      transition: all 0.3s ease;
    }

    .zoom-icon:hover {
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      transform: scale(1.1);
    }

    /* Thumbnail Gallery */
    .thumbnail-gallery {
      display: flex;
      gap: 15px;
      overflow-x: auto;
      padding: 10px 0;
    }

    .thumbnail {
      width: 100px;
      height: 100px;
      border-radius: 10px;
      overflow: hidden;
      border: 2px solid rgba(0, 219, 222, 0.3);
      cursor: pointer;
      transition: all 0.3s ease;
      flex-shrink: 0;
      background: linear-gradient(135deg, rgba(0, 219, 222, 0.1), rgba(252, 0, 255, 0.1));
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .thumbnail.active {
      border-color: #00dbde;
      box-shadow: 0 0 15px rgba(0, 219, 222, 0.5);
      transform: scale(1.05);
    }

    .thumbnail:hover {
      transform: scale(1.05);
      border-color: #fc00ff;
    }

    .thumbnail img {
      max-width: 90%;
      max-height: 90%;
      object-fit: contain;
    }

    /* Product Details */
    .product-details {
      background: rgba(30, 41, 59, 0.7);
      border-radius: 20px;
      padding: 40px;
      border: 2px solid rgba(0, 219, 222, 0.3);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
    }

    .product-brand {
      font-size: 14px;
      color: #00dbde;
      font-weight: 600;
      margin-bottom: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .product-title {
      font-size: 36px;
      font-weight: 800;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      line-height: 1.2;
    }

    .product-rating {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }

    .stars {
      color: #ffd700;
      font-size: 18px;
    }

    .rating-count {
      color: #94a3b8;
      font-size: 14px;
    }

    .product-price {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 30px;
    }

    .current-price {
      font-size: 42px;
      font-weight: 800;
      color: #00dbde;
      text-shadow: 0 2px 10px rgba(0, 219, 222, 0.3);
    }

    .original-price {
      font-size: 24px;
      color: #94a3b8;
      text-decoration: line-through;
    }

    .discount-badge {
      background: linear-gradient(135deg, #ff6b6b, #ff3838);
      color: white;
      padding: 6px 15px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 700;
    }

    .product-description {
      color: #cbd5e1;
      line-height: 1.6;
      margin-bottom: 30px;
      font-size: 16px;
    }

    /* Size Selector */
    .size-selector {
      margin-bottom: 30px;
    }

    .size-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 15px;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .size-title i {
      color: #00dbde;
    }

    .size-options {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .size-option {
      width: 60px;
      height: 60px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.05);
      color: #cbd5e1;
    }

    .size-option:hover {
      border-color: #00dbde;
      transform: translateY(-3px);
      background: rgba(0, 219, 222, 0.1);
    }

    .size-option.selected {
      border-color: #00dbde;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      color: white;
      box-shadow: 0 5px 15px rgba(0, 219, 222, 0.3);
    }

    /* Color Selector */
    .color-selector {
      margin-bottom: 30px;
    }

    .color-options {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .color-option {
      width: 45px;
      height: 45px;
      border-radius: 50%;
      cursor: pointer;
      border: 3px solid transparent;
      transition: all 0.3s ease;
      position: relative;
    }

    .color-option:hover {
      transform: scale(1.1);
    }

    .color-option.selected {
      border-color: #ffffff;
      box-shadow: 0 0 0 2px #00dbde;
    }

    .color-option::after {
      content: '✓';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: white;
      font-weight: bold;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .color-option.selected::after {
      opacity: 1;
    }

    /* Quantity Selector */
    .quantity-selector {
      margin-bottom: 30px;
    }

    .quantity-control {
      display: flex;
      align-items: center;
      gap: 15px;
      background: rgba(30, 41, 59, 0.8);
      border-radius: 15px;
      padding: 10px;
      border: 2px solid rgba(0, 219, 222, 0.3);
      width: fit-content;
    }

    .qty-btn {
      width: 50px;
      height: 50px;
      border: none;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      color: white;
      font-size: 24px;
      font-weight: bold;
      border-radius: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }

    .qty-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 5px 15px rgba(0, 219, 222, 0.3);
    }

    .qty-value {
      width: 80px;
      text-align: center;
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
    }

    /* Action Buttons */
    .action-buttons {
      display: flex;
      gap: 20px;
      margin-bottom: 30px;
    }

    .add-to-cart-btn {
      flex: 2;
      padding: 20px;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      border: none;
      border-radius: 15px;
      color: white;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      box-shadow: 0 10px 25px rgba(0, 219, 222, 0.3);
    }

    .add-to-cart-btn:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0, 219, 222, 0.4);
    }

    .wishlist-btn {
      flex: 1;
      padding: 20px;
      background: rgba(255, 255, 255, 0.1);
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-radius: 15px;
      color: white;
      font-size: 18px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .wishlist-btn:hover {
      background: rgba(255, 255, 255, 0.2);
      border-color: #00dbde;
      transform: translateY(-3px);
    }

    .wishlist-btn.active {
      background: linear-gradient(135deg, #ff6b6b, #ff3838);
      border-color: transparent;
    }

    /* Product Features */
    .product-features {
      background: rgba(30, 41, 59, 0.7);
      border-radius: 20px;
      padding: 30px;
      border: 2px solid rgba(0, 219, 222, 0.3);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
      margin-bottom: 60px;
    }

    .features-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 25px;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .features-title i {
      color: #00dbde;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .feature {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .feature-icon {
      width: 50px;
      height: 50px;
      background: linear-gradient(135deg, rgba(0, 219, 222, 0.2), rgba(252, 0, 255, 0.2));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: #00dbde;
    }

    .feature-text {
      flex: 1;
    }

    .feature-title {
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 5px;
    }

    .feature-desc {
      color: #94a3b8;
      font-size: 14px;
    }

    /* Reviews Section */
    .reviews-section {
      background: rgba(30, 41, 59, 0.7);
      border-radius: 20px;
      padding: 30px;
      border: 2px solid rgba(0, 219, 222, 0.3);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
    }

    .reviews-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .reviews-title {
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
    }

    .write-review-btn {
      padding: 12px 25px;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      border: none;
      border-radius: 10px;
      color: white;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .write-review-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 20px rgba(0, 219, 222, 0.3);
    }

    .review {
      background: rgba(15, 23, 42, 0.9);
      border-radius: 15px;
      padding: 25px;
      margin-bottom: 20px;
      border: 1px solid rgba(0, 219, 222, 0.2);
    }

    .review-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }

    .reviewer {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .reviewer-avatar {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: white;
    }

    .reviewer-info h4 {
      color: #ffffff;
      margin-bottom: 5px;
    }

    .reviewer-info span {
      color: #94a3b8;
      font-size: 14px;
    }

    .review-content {
      color: #cbd5e1;
      line-height: 1.6;
    }

    /* Related Products */
    .related-products {
      margin-top: 60px;
    }

    .related-title {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 30px;
      text-align: center;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }

    .products-slider {
      position: relative;
      padding: 20px 0;
    }

    .swiper {
      width: 100%;
      padding: 20px;
    }

    .swiper-slide {
      background: rgba(30, 41, 59, 0.7);
      border-radius: 15px;
      padding: 20px;
      border: 2px solid rgba(0, 219, 222, 0.2);
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .swiper-slide:hover {
      transform: translateY(-10px);
      border-color: #00dbde;
      box-shadow: 0 15px 30px rgba(0, 219, 222, 0.2);
    }

    .swiper-button-next,
    .swiper-button-prev {
      color: #00dbde !important;
      background: rgba(0, 219, 222, 0.1);
      width: 50px;
      height: 50px;
      border-radius: 50%;
    }

    .swiper-button-next:after,
    .swiper-button-prev:after {
      font-size: 20px !important;
    }

    /* Footer */
    .footer {
      text-align: center;
      padding: 30px;
      color: #94a3b8;
      font-size: 14px;
      border-top: 1px solid rgba(0, 219, 222, 0.2);
      margin-top: 50px;
      background: rgba(15, 23, 42, 0.8);
    }

    .footer-logo {
      font-size: 20px;
      font-weight: 700;
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      margin-bottom: 10px;
    }

    /* Responsive Design */
    @media (max-width: 1200px) {
      .product-container {
        padding: 0 30px;
      }
      
      .product-grid {
        gap: 40px;
      }
      
      .main-image-container {
        height: 400px;
      }
    }

    @media (max-width: 992px) {
      .product-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }
      
      .main-image-container {
        height: 450px;
      }
    }

    @media (max-width: 768px) {
      .navbar {
        padding: 0 20px;
        height: 60px;
      }
      
      .logo {
        font-size: 24px;
      }
      
      .nav-links {
        gap: 15px;
      }
      
      .nav-links a {
        padding: 8px 12px;
        font-size: 14px;
      }
      
      .product-container {
        padding: 0 20px;
      }
      
      .product-title {
        font-size: 28px;
      }
      
      .current-price {
        font-size: 36px;
      }
      
      .action-buttons {
        flex-direction: column;
      }
      
      .main-image-container {
        height: 350px;
      }
      
      .thumbnail {
        width: 80px;
        height: 80px;
      }
    }

    @media (max-width: 480px) {
      .navbar {
        flex-direction: column;
        height: auto;
        padding: 15px;
      }
      
      .nav-links {
        margin-top: 15px;
        flex-wrap: wrap;
        justify-content: center;
      }
      
      .product-details,
      .image-gallery {
        padding: 20px;
      }
      
      .product-title {
        font-size: 24px;
      }
      
      .current-price {
        font-size: 32px;
      }
      
      .main-image-container {
        height: 300px;
      }
      
      .thumbnail {
        width: 70px;
        height: 70px;
      }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }

    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.8);
    }

    ::-webkit-scrollbar-thumb {
      background: linear-gradient(135deg, #00dbde, #fc00ff);
      border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(135deg, #fc00ff, #00dbde);
    }
  </style>
</head>

<body>

  <!-- Navigation Bar 
  <nav class="navbar">
    <div class="logo">Scratch</div>
    <div class="nav-links">
      <a href="/shop">Shop</a>
      <a href="/cart">Cart</a>
      <a href="/myaccount">My Account</a>
    </div>
  </nav>

  <!-- Main Product Container 
  <div class="product-container">
    
    <!-- Product Grid 
    <div class="product-grid">
      
      <!-- Image Gallery 
      <div class="image-gallery">
        <div class="main-image-container">
          <img id="mainImage" src="data:image/jpeg;base64,<%=product.image.toString('base64')%>" alt="Product Main Image" class="main-image">
          <div class="zoom-icon" onclick="zoomImage()">
            <i class="fas fa-search-plus"></i>
          </div>
        </div>
        
        <!-- Thumbnail Gallery 
        <div class="thumbnail-gallery">
          <div class="thumbnail active" onclick="changeImage(this, 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80')">
            <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Front View">
          </div>
          <div class="thumbnail" onclick="changeImage(this, 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80')">
            <img src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Side View">
          </div>
          <div class="thumbnail" onclick="changeImage(this, 'https://images.unsplash.com/photo-1606107557195-0e29a4b5b4aa?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80')">
            <img src="https://images.unsplash.com/photo-1606107557195-0e29a4b5b4aa?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Back View">
          </div>
          <div class="thumbnail" onclick="changeImage(this, 'https://images.unsplash.com/photo-1597045566677-8cf032ed6634?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80')">
            <img src="https://images.unsplash.com/photo-1597045566677-8cf032ed6634?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Top View">
          </div>
          <div class="thumbnail" onclick="changeImage(this, 'https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80')">
            <img src="https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Detail View">
          </div>
        </div>
      </div>
      
      <!-- Product Details 
      <div class="product-details">
        <div class="product-brand">PREMIUM COLLECTION</div>
        <h1 class="product-title">Nike Air Max 270 React</h1>
        
        <div class="product-rating">
          <div class="stars">
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
